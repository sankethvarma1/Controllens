# CONTROLLENS Environment Configuration
# Copy this file to .env and fill in your values

# Database
POSTGRES_PASSWORD=controllens
DATABASE_URL=postgresql://controllens:controllens@localhost:5432/controllens

# LLM Configuration (NVIDIA Nemotron)
LLM_API_KEY=your_nvidia_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: Email/SMTP for notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: S3/MinIO for file storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=